{
	"name": "turan-widget",
	"version": "0.1.1",
	"description": "Turan widget - trusted companion for the Turan plugin: in-page React AI widget (canvas, element picker, translations) and dev file tools",
	"type": "module",
	"license": "MIT",
	"exports": {
		".": "./src/index.ts",
		"./admin": "./src/admin.tsx",
		"./bundle": "./src/widget-bundle.generated.ts"
	},
	"files": [
		"src",
		"scripts",
		"README.md",
		"LICENSE"
	],
	"scripts": {
		"build:widget": "node scripts/build-widget.mjs",
		"typecheck": "tsc --noEmit",
		"prepublishOnly": "npm run build:widget"
	},
	"peerDependencies": {
		"emdash": ">=1.3.0",
		"react": ">=18"
	},
	"dependencies": {
		"zod": "^4.0.0"
	},
	"devDependencies": {
		"@types/node": "^22.0.0",
		"@types/react": "^19.0.0",
		"@types/react-dom": "^19.0.0",
		"esbuild": "^0.25.0",
		"react": "^19.2.0",
		"react-dom": "^19.2.0",
		"typescript": "^5.7.0"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/fuatcangnc/turanai.git",
		"directory": "packages/turan-widget"
	},
	"homepage": "https://github.com/fuatcangnc/turanai/tree/main/packages/turan-widget#readme",
	"bugs": {
		"url": "https://github.com/fuatcangnc/turanai/issues"
	},
	"publishConfig": {
		"access": "public"
	},
	"engines": {
		"node": ">=20"
	}
}
