---
/**
 * Turan launcher — site-owned UI for the sandboxed Turan plugin.
 *
 * Sandboxed plugins cannot inject scripts or markup into pages (EmDash treats
 * `page:fragments` as trusted-only), so this small, framework-free client
 * lives in the *site's* code. All authority stays in the plugin: the launcher
 * only calls the plugin's private routes with the admin session cookie and the
 * EmDash CSRF header.
 *
 * Usage (any Astro layout):
 *
 *   import TuranLauncher from "turan-emdash/launcher.astro";
 *   ...
 *   <TuranLauncher />
 *
 * It renders nothing for visitors who are not signed in to the admin.
 */

interface Props {
	/** Base path of the plugin API (default matches the `turan` plugin slug). */
	base?: string;
	/** Optional link target for the full admin page. */
	adminPath?: string;
}

const { base = "/_emdash/api/plugins/turan", adminPath = "/_emdash/admin/plugins/turan/chat" } = Astro.props;
---

<div id="turan-launcher" data-base={base} data-admin={adminPath} hidden>
	<button id="turan-launcher-btn" type="button" aria-haspopup="dialog" aria-expanded="false">✦ AI</button>
	<section id="turan-launcher-panel" role="dialog" aria-label="Turan AI" hidden>
		<header>
			<span>✦ Turan AI</span>
			<a href={adminPath} target="_blank" rel="noreferrer">Admin</a>
			<button id="turan-launcher-close" type="button" aria-label="Kapat">✕</button>
		</header>
		<div id="turan-launcher-log" aria-live="polite"></div>
		<form id="turan-launcher-form">
			<textarea id="turan-launcher-input" rows="2" placeholder="İçerik üzerinde bir değişiklik iste…"></textarea>
			<button type="submit">Gönder</button>
		</form>
	</section>
</div>

<style>
	#turan-launcher-btn {
		position: fixed;
		left: 14px;
		bottom: 14px;
		z-index: 2147483000;
		display: inline-flex;
		align-items: center;
		gap: 6px;
		padding: 9px 15px;
		border: none;
		border-radius: 999px;
		background: #242423;
		color: #dcdbd7;
		font: 500 13px/1 ui-sans-serif, system-ui, sans-serif;
		cursor: pointer;
	}
	#turan-launcher-btn:hover {
		background: #2e2e2c;
	}
	#turan-launcher-panel {
		position: fixed;
		left: 14px;
		bottom: 60px;
		z-index: 2147483001;
		width: min(380px, calc(100vw - 28px));
		max-height: min(60vh, 520px);
		display: flex;
		flex-direction: column;
		background: #1b1b1a;
		color: #dcdbd7;
		border-radius: 14px;
		overflow: hidden;
		box-shadow: 0 18px 44px rgba(0, 0, 0, 0.45);
		font: 13.5px/1.55 ui-sans-serif, system-ui, sans-serif;
	}
	#turan-launcher-panel header {
		display: flex;
		align-items: center;
		gap: 10px;
		padding: 10px 12px;
		font-weight: 600;
		font-size: 13px;
	}
	#turan-launcher-panel header a {
		margin-inline-start: auto;
		color: #9a9994;
		font-size: 12px;
		text-decoration: none;
	}
	#turan-launcher-panel header a:hover {
		color: #e3e2df;
	}
	#turan-launcher-close {
		border: none;
		background: transparent;
		color: #8b8a86;
		cursor: pointer;
		font-size: 13px;
		padding: 2px 4px;
	}
	#turan-launcher-close:hover {
		color: #e3e2df;
	}
	#turan-launcher-log {
		flex: 1;
		overflow-y: auto;
		padding: 4px 12px 10px;
		display: flex;
		flex-direction: column;
		gap: 10px;
	}
	#turan-launcher-log .t-user {
		align-self: flex-end;
		max-width: 88%;
		background: #333331;
		border-radius: 12px;
		padding: 7px 12px;
		white-space: pre-wrap;
	}
	#turan-launcher-log .t-bot {
		white-space: pre-wrap;
		color: #d9d8d4;
	}
	#turan-launcher-log .t-note {
		color: #807f7b;
		font-style: italic;
		font-size: 12px;
	}
	#turan-launcher-log .t-err {
		color: #e06c6c;
		white-space: pre-wrap;
	}
	#turan-launcher-log .t-tools {
		color: #84837f;
		font-size: 12px;
	}
	#turan-launcher-form {
		display: flex;
		gap: 8px;
		padding: 8px 10px 10px;
		background: #242422;
	}
	#turan-launcher-input {
		flex: 1;
		resize: none;
		border: none;
		outline: none;
		background: transparent;
		color: #e4e3e0;
		font: inherit;
		padding: 6px 8px;
	}
	#turan-launcher-form button {
		border: none;
		border-radius: 9px;
		background: #4a4a47;
		color: #eeedea;
		font: inherit;
		padding: 8px 14px;
		cursor: pointer;
	}
	#turan-launcher-form button:disabled {
		opacity: 0.5;
		cursor: default;
	}
</style>

<script is:inline>
	(function () {
		if (window.__turanLauncher) return;
		window.__turanLauncher = true;
		var root = document.getElementById("turan-launcher");
		if (!root) return;
		var base = root.dataset.base || "/_emdash/api/plugins/turan";
		var btn = document.getElementById("turan-launcher-btn");
		var panel = document.getElementById("turan-launcher-panel");
		var closeBtn = document.getElementById("turan-launcher-close");
		var log = document.getElementById("turan-launcher-log");
		var form = document.getElementById("turan-launcher-form");
		var input = document.getElementById("turan-launcher-input");
		var sessionId = null;

		function call(route, body) {
			return fetch(base + "/" + route, {
				method: "POST",
				headers: { "Content-Type": "application/json", "X-EmDash-Request": "1" },
				credentials: "same-origin",
				body: JSON.stringify(body || {}),
			}).then(function (res) {
				return res.json().catch(function () { return {}; }).then(function (json) {
					if (!res.ok || !json.success) throw new Error((json.error && json.error.message) || "HTTP " + res.status);
					return json.data;
				});
			});
		}
		function add(cls, text) {
			var node = document.createElement("div");
			node.className = cls;
			node.textContent = text;
			log.appendChild(node);
			log.scrollTop = log.scrollHeight;
			return node;
		}
		function setOpen(open) {
			panel.hidden = !open;
			btn.setAttribute("aria-expanded", open ? "true" : "false");
			if (open) input.focus();
		}
		btn.addEventListener("click", function () { setOpen(panel.hidden); });
		closeBtn.addEventListener("click", function () { setOpen(false); });
		document.addEventListener("keydown", function (e) {
			if (e.key === "Escape" && !panel.hidden) setOpen(false);
		});
		form.addEventListener("submit", function (e) {
			e.preventDefault();
			var text = (input.value || "").trim();
			if (!text) return;
			input.value = "";
			add("t-user", text);
			var wait = add("t-note", "Turan çalışıyor…");
			var submit = form.querySelector("button");
			submit.disabled = true;
			call("ask", { message: text, sessionId: sessionId || undefined })
				.then(function (data) {
					wait.remove();
					sessionId = data.sessionId || sessionId;
					if (data.ok === false) add("t-err", data.error || "İstek tamamlanamadı.");
					else add("t-bot", data.answer);
					if (data.toolCalls && data.toolCalls.length) {
						add("t-tools", "araçlar: " + data.toolCalls.map(function (t) { return t.name + (t.ok ? " ✓" : " ✗"); }).join(", "));
					}
				})
				.catch(function (err) {
					wait.remove();
					add("t-err", err.message);
				})
				.finally(function () { submit.disabled = false; });
		});

		// Only signed-in admins can reach the private routes; everyone else sees nothing.
		call("status")
			.then(function () { root.hidden = false; })
			.catch(function () { root.remove(); });
	})();
</script>
