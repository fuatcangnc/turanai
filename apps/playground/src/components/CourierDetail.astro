<script is:inline>
  // Setup Courier Offer Form submission to WhatsApp
  document.addEventListener('DOMContentLoaded', () => {
    const form = document.getElementById('courier-offer-form')
    if (form) {
      form.addEventListener('submit', (e) => {
        e.preventDefault()
        const fullName = document.getElementById('courier-fullName')?.value || ''
        const phone = document.getElementById('courier-phone')?.value || ''
        const brand = document.querySelector('[data-courier-company]')?.getAttribute('data-courier-company') || 'Kurye'
        
        const message = [
          'Merhaba,',
          `${brand} için motosiklet çanta ruhsata işletme hizmetinde teklif almak istiyorum.`,
          '',
          `Ad soyad: ${fullName}`,
          `Telefon: ${phone}`
        ].join('\n')

        const whatsappNumber = '905465135855'
        window.open(`https://wa.me/${whatsappNumber}?text=${encodeURIComponent(message)}`, '_blank')
      })
    }
  })
</script>
