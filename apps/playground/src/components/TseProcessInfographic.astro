---
// TseProcessInfographic.astro - Step-by-step sequential card entrance over car infographic
import SiteImage from './SiteImage.astro'
---

<div class="tse-process-stage relative w-full max-w-[660px] lg:max-w-none mx-auto select-none">
  <!-- Container maintaining the exact 1536x1024 aspect ratio -->
  <div class="relative w-full aspect-[1536/1024] overflow-visible">
    <!-- Base Background: Clean Car Illustration with Connecting Arrows & Technical Dots -->
    <picture>
      <source media="(max-width: 640px)" srcset="/karakas-tse-surec-infografik-320.webp" />
      <SiteImage
        src="/karakas-tse-surec-infografik-520.webp"
        srcset="/karakas-tse-surec-infografik-520.webp 600w, /karakas-tse-surec-infografik.webp 720w"
        sizes="800px"
        alt="TSE Onaylı Araç Proje ve Tadilat Süreci"
        class="base-car-img absolute inset-0 size-full object-contain pointer-events-none drop-shadow-md"
        width="960"
        height="640"
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
    </picture>

    <!-- Sequentially Animating Step Cards (Zoom + Fade In 1-by-1) -->

    <!-- Card 1: Başvuru (Enters 1st at 0.2s) -->
    <div
      class="animated-card card-step-1 absolute"
      style="left: 0%; top: 0%; width: 31.25%;"
    >
      <SiteImage
        src="/images/infographic/card-1.webp"
        alt="1. Adım Başvuru"
        class="w-full h-auto drop-shadow-lg transition-transform duration-300 hover:scale-105"
      />
    </div>

    <!-- Card 2: Proje Çizimi (Enters 2nd at 0.7s) -->
    <div
      class="animated-card card-step-2 absolute"
      style="left: 31.90%; top: 0%; width: 31.90%;"
    >
      <SiteImage
        src="/images/infographic/card-2.webp"
        alt="2. Adım Proje Çizimi"
        class="w-full h-auto drop-shadow-lg transition-transform duration-300 hover:scale-105"
      />
    </div>

    <!-- Card 3: TSE Onayı (Enters 3rd at 1.2s) -->
    <div
      class="animated-card card-step-3 absolute"
      style="left: 67.70%; top: 5.86%; width: 32.30%;"
    >
      <SiteImage
        src="/images/infographic/card-3.webp"
        alt="3. Adım TSE Onayı"
        class="w-full h-auto drop-shadow-lg transition-transform duration-300 hover:scale-105"
      />
    </div>

    <!-- Card 4: Muayene (Enters 4th at 1.7s) -->
    <div
      class="animated-card card-step-4 absolute"
      style="left: 2.60%; top: 75.20%; width: 27.34%;"
    >
      <SiteImage
        src="/images/infographic/card-4.webp"
        alt="4. Adım Muayene"
        class="w-full h-auto drop-shadow-lg transition-transform duration-300 hover:scale-105"
      />
    </div>

    <!-- Card 5: Ruhsat İşlemi (Enters 5th at 2.2s) -->
    <div
      class="animated-card card-step-5 absolute"
      style="left: 71.60%; top: 72.26%; width: 28.38%;"
    >
      <SiteImage
        src="/images/infographic/card-5.webp"
        alt="5. Adım Ruhsat İşlemi"
        class="w-full h-auto drop-shadow-lg transition-transform duration-300 hover:scale-105"
      />
    </div>

    <!-- Target Dots Glowing Radar Beacons on the Car (Synchronized) -->
    <!-- Beacon 1: Hood (Kaput) -->
    <div class="beacon beacon-1 absolute -translate-x-1/2 -translate-y-1/2 left-[18.9%] top-[45.7%] size-[3.2%] pointer-events-none" aria-hidden="true">
      <span class="absolute inset-0 rounded-full bg-primary animate-ping opacity-80"></span>
      <span class="relative block size-full rounded-full border-2 border-white bg-primary/60 shadow-xs"></span>
    </div>

    <!-- Beacon 2: Roof (Tavan) -->
    <div class="beacon beacon-2 absolute -translate-x-1/2 -translate-y-1/2 left-[54.0%] top-[30.5%] size-[3.2%] pointer-events-none" aria-hidden="true">
      <span class="absolute inset-0 rounded-full bg-primary animate-ping opacity-80"></span>
      <span class="relative block size-full rounded-full border-2 border-white bg-primary/60 shadow-xs"></span>
    </div>

    <!-- Beacon 3: Tank (LPG Tankı) -->
    <div class="beacon beacon-3 absolute -translate-x-1/2 -translate-y-1/2 left-[67.1%] top-[54.1%] size-[3.2%] pointer-events-none" aria-hidden="true">
      <span class="absolute inset-0 rounded-full bg-primary animate-ping opacity-80"></span>
      <span class="relative block size-full rounded-full border-2 border-white bg-primary/60 shadow-xs"></span>
    </div>

    <!-- Beacon 4: Towbar (Çeki Demiri) -->
    <div class="beacon beacon-4 absolute -translate-x-1/2 -translate-y-1/2 left-[18.9%] top-[68.2%] size-[3.2%] pointer-events-none" aria-hidden="true">
      <span class="absolute inset-0 rounded-full bg-primary animate-ping opacity-80"></span>
      <span class="relative block size-full rounded-full border-2 border-white bg-primary/60 shadow-xs"></span>
    </div>

    <!-- Beacon 5: License Plate (Plaka) -->
    <div class="beacon beacon-5 absolute -translate-x-1/2 -translate-y-1/2 left-[90.8%] top-[55.2%] size-[3.2%] pointer-events-none" aria-hidden="true">
      <span class="absolute inset-0 rounded-full bg-primary animate-ping opacity-80"></span>
      <span class="relative block size-full rounded-full border-2 border-white bg-primary/60 shadow-xs"></span>
    </div>
  </div>
</div>

<style>
  /* Base Car Subtle Fade */
  .base-car-img {
    animation: baseCarFade 0.6s ease-out both;
  }

  @keyframes baseCarFade {
    0% {
      opacity: 0;
      transform: scale(0.95);
    }
    100% {
      opacity: 1;
      transform: scale(1);
    }
  }

  /* Keyframe for Step Cards Sequential Zoom + Spring Entrance */
  @keyframes cardPopEntrance {
    0% {
      opacity: 0;
      transform: scale(0.15) translateY(30px);
      filter: drop-shadow(0 0 0 rgba(0, 0, 0, 0));
    }
    65% {
      opacity: 1;
      transform: scale(1.10) translateY(-6px);
      filter: drop-shadow(0 14px 28px rgba(221, 100, 30, 0.45));
    }
    85% {
      transform: scale(0.96) translateY(2px);
    }
    100% {
      opacity: 1;
      transform: scale(1) translateY(0);
      filter: drop-shadow(0 4px 14px rgba(0, 0, 0, 0.12));
    }
  }

  .animated-card {
    cursor: pointer;
    z-index: 10;
  }

  .animated-card:hover {
    z-index: 30;
  }

  /* Staggered Entrance Timings (Cards 1 to 5) */
  .card-step-1 {
    transform-origin: 15% 20%;
    animation: cardPopEntrance 0.7s cubic-bezier(0.34, 1.56, 0.64, 1) 0.2s both;
  }

  .card-step-2 {
    transform-origin: 50% 15%;
    animation: cardPopEntrance 0.7s cubic-bezier(0.34, 1.56, 0.64, 1) 0.7s both;
  }

  .card-step-3 {
    transform-origin: 80% 20%;
    animation: cardPopEntrance 0.7s cubic-bezier(0.34, 1.56, 0.64, 1) 1.2s both;
  }

  .card-step-4 {
    transform-origin: 20% 80%;
    animation: cardPopEntrance 0.7s cubic-bezier(0.34, 1.56, 0.64, 1) 1.7s both;
  }

  .card-step-5 {
    transform-origin: 80% 80%;
    animation: cardPopEntrance 0.7s cubic-bezier(0.34, 1.56, 0.64, 1) 2.2s both;
  }

  /* Staggered Entrance Timings (Radar Beacons 1 to 5) */
  @keyframes beaconEntrance {
    0% {
      opacity: 0;
      transform: translate(-50%, -50%) scale(0);
    }
    100% {
      opacity: 1;
      transform: translate(-50%, -50%) scale(1);
    }
  }

  .beacon-1 { animation: beaconEntrance 0.4s ease 0.2s both; }
  .beacon-2 { animation: beaconEntrance 0.4s ease 0.7s both; }
  .beacon-3 { animation: beaconEntrance 0.4s ease 1.2s both; }
  .beacon-4 { animation: beaconEntrance 0.4s ease 1.7s both; }
  .beacon-5 { animation: beaconEntrance 0.4s ease 2.2s both; }
</style>
