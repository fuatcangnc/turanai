---
import type { Service } from '@/data/site'
import { defaultServices, phoneHref, siteSettings, whatsappHref } from '@/data/site'
import { ArrowRight, BadgeCheck, CircleCheck, FileCheck, Phone, ShieldCheck } from '@lucide/astro'
import ProjectForm from './ProjectForm.astro'
import MotorChangeService from './services/MotorChangeService.astro'
import ConfiguredProjectService from './services/ConfiguredProjectService.astro'
import SiteImage from './SiteImage.astro'

interface Props { service: Service }
const { service } = Astro.props

const serviceJsonModules = import.meta.glob<{ default: any }>('../content/services/*.json', { eager: true })
const matchingModule = Object.entries(serviceJsonModules).find(([path]) => path.endsWith(`/${service.slug}.json`))
const richData = matchingModule?.[1]?.default || service

const isMotorChange = service.slug === 'arac-motor-degisim-projesi'
const isConfiguredService = !isMotorChange && Boolean(richData.group || richData.process || richData.technicalChecks)

const related = defaultServices.filter((item) => item.category === service.category && item.slug !== service.slug).slice(0, 3)
const serviceFaqs = [
  [`${service.shortTitle} için proje gerekir mi?`, 'Uygulamanın araca ve ruhsat bilgilerine etkisine göre teknik proje gerekip gerekmediği ön kontrolde belirlenir.'],
  ['Hangi belgeler hazırlanmalıdır?', 'Ruhsat, araç kimlik bilgileri, uygulamaya ait teknik belgeler ve varsa montaj/fatura kayıtları incelenir. Kesin liste araç özelinde paylaşılır.'],
  ['TSE ve ruhsat işlemleri nasıl ilerler?', 'Teknik uygunluk kontrolünden sonra proje dosyası hazırlanır. Kontrol, muayene ve tescil sırası size açık biçimde aktarılır.'],
]
---

{isMotorChange ? (
  <MotorChangeService service={richData} />
) : isConfiguredService ? (
  <ConfiguredProjectService service={richData} />
) : (
  <main>
    <!-- Schema.org JSON-LD (BreadcrumbList + Service) -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "BreadcrumbList",
          "itemListElement": [
            {
              "@type": "ListItem",
              "position": 1,
              "name": "Ana Sayfa",
              "item": "https://karakasmuhendislik.com.tr"
            },
            {
              "@type": "ListItem",
              "position": 2,
              "name": "Araç Proje Hizmetlerimiz",
              "item": "https://karakasmuhendislik.com.tr/arac-proje-hizmetlerimiz"
            },
            {
              "@type": "ListItem",
              "position": 3,
              "name": service.shortTitle || service.title,
              "item": `https://karakasmuhendislik.com.tr/${service.slug}`
            }
          ]
        },
        {
          "@type": "Service",
          "name": service.title,
          "description": service.summary,
          "provider": {
            "@type": "LocalBusiness",
            "name": "Karakaş Mühendislik",
            "telephone": siteSettings.phone,
            "address": {
              "@type": "PostalAddress",
              "addressLocality": "Gaziosmanpaşa",
              "addressRegion": "İstanbul",
              "addressCountry": "TR"
            }
          },
          "url": `https://karakasmuhendislik.com.tr/${service.slug}`
        }
      ]
    })} />

    <section class="detail-hero relative overflow-hidden">
      <div class="detail-hero__image"><SiteImage src="/karakas-muhendislik-arac-proje-hizmetleri-bg.webp" alt={service.title} fetchpriority="high" /></div>
      <div class="shell detail-hero__content">
        <h2 class="eyebrow">{service.category} · TSE onaylı hizmet</h2>
        <h1>{service.title}</h1>
        <p class="detail-hero__summary">{service.summary}</p>
        <div class="detail-hero__actions">
          <a class="button button--primary" href="#proje-talebi">Projenizi değerlendirelim <ArrowRight size={16} /></a>
          <a class="button" style="border-color: var(--navy-soft); color: var(--navy-soft)" href={whatsappHref(`${service.shortTitle} hakkında bilgi almak istiyorum.`)} target="_blank" rel="noreferrer">WhatsApp ile sorun</a>
        </div>
        <nav class="breadcrumbs" aria-label="Breadcrumb" itemscope itemtype="https://schema.org/BreadcrumbList">
          <span itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
            <a itemprop="item" href="/"><span itemprop="name">Ana Sayfa</span></a>
            <meta itemprop="position" content="1" />
          </span>
          <ArrowRight size={13} aria-hidden="true" />
          <span itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
            <a itemprop="item" href="/arac-proje-hizmetlerimiz"><span itemprop="name">Araç Proje Hizmetlerimiz</span></a>
            <meta itemprop="position" content="2" />
          </span>
          <ArrowRight size={13} aria-hidden="true" />
          <span itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
            <span itemprop="name">{service.shortTitle}</span>
            <meta itemprop="item" content={`https://karakasmuhendislik.com.tr/${service.slug}`} />
            <meta itemprop="position" content="3" />
          </span>
        </nav>
      </div>
      <div class="custom-divider-white-left absolute -bottom-[1px] left-0 z-20 pointer-events-none border-0 outline-none shadow-none" aria-hidden="true"></div>
      <div class="custom-divider-white-right absolute -bottom-[1px] right-0 z-20 pointer-events-none border-0 outline-none shadow-none" aria-hidden="true"></div>
    </section>

    <section class="detail-layout"><div class="shell detail-layout">
      <article class="detail-main">
        <h3 class="section-kicker">Teknik kapsam</h3>
        <h2>{service.shortTitle} sürecini doğru planlayın.</h2>
        <p>Aracınızdaki değişikliğin teknik uygunluğu; araç tipi, mevcut ruhsat bilgileri, uygulamanın ölçüleri ve kullanılan donanımlar birlikte değerlendirilerek belirlenir. Karakaş Mühendislik, başvuru öncesinden ruhsata işletme adımına kadar izlemeniz gereken yolu anlaşılır hale getirir.</p>
        <h3>Kontrol noktaları</h3>
        <ul><li>Ruhsat ve araç kimlik bilgilerinin kontrolü</li><li>Uygulamanın araç üzerindeki ölçü ve bağlantı detayları</li><li>Ürün, ekipman ve montaj belgelerinin doğrulanması</li><li>Teknik proje, TSE kontrolü ve muayene sırasının planlanması</li></ul>
        <h3>Gerekli belgeler</h3>
        <p>İlk görüşmede ruhsat, araç model ve şasi bilgileri, uygulanacak değişikliğe ait fotoğraflar ile ürün veya montaj belgelerini hazır bulundurmanız süreci hızlandırır. Hizmete göre ek belge ihtiyacı teknik ön kontrolde netleştirilir.</p>
        <div class="process-band" style="margin-top: 2.5rem"><h3 class="section-kicker">İzlenecek yol</h3><h2>Beş adımda kontrollü ilerleme.</h2><div class="process-band__grid">{[['01', 'Ön değerlendirme', 'Araç ve uygulama bilgileri incelenir.'], ['02', 'Teknik veri', 'Ölçü, belge ve montaj detayları toplanır.'], ['03', 'Proje dosyası', 'Teknik çizim ve açıklamalar hazırlanır.'], ['04', 'Onay ve kontrol', 'Başvuru ve kontrol adımları takip edilir.'], ['05', 'Tescil desteği', 'Muayene ve ruhsata işletme yolu netleştirilir.']].map(([number, title, text]) => <div class="process-band__item"><span>{number}</span><h3>{title}</h3><p>{text}</p></div>)}</div></div>
        <h3>Sıkça sorulanlar</h3><div class="faq-list">{serviceFaqs.map(([question, answer]) => <details><summary>{question}<span><CircleCheck size={15} /></span></summary><p>{answer}</p></details>)}</div>
      </article>
      <aside class="detail-side"><div class="side-card"><h3 class="eyebrow"><ShieldCheck size={16} /> Uzman mühendislik desteği</h3><h2>Aracınız için doğru proje yolunu netleştirelim.</h2><p>Bilgilerinizi paylaşın; uygun kapsam, belgeler ve sonraki adımlar için size dönüş yapalım.</p><a class="button button--primary" href={whatsappHref(`${service.shortTitle} için ön değerlendirme istiyorum.`)} target="_blank" rel="noreferrer">WhatsApp'tan danışın <ArrowRight size={15} /></a><a class="button" style="width:100%; margin-top:.6rem; border:1px solid var(--line)" href={phoneHref}><Phone size={15} /> {siteSettings.phone}</a><ul class="info-list"><li><BadgeCheck size={15} /> Teknik uygunluk kontrolü</li><li><FileCheck size={15} /> Belge ve proje planı</li><li><ShieldCheck size={15} /> Tescil yönlendirmesi</li></ul></div></aside>
    </div></section>

    <section class="form-section" id="proje-talebi"><div class="shell form-section__panel"><SiteImage class="form-section__image" src="/images/project-guidance.webp" alt="Teknik proje danışmanlığı" /><div class="form-section__wash"></div><ProjectForm services={defaultServices} title={`${service.shortTitle} için teklif alın`} /><div class="form-section__aside"><h3 class="eyebrow">Karakaş Mühendislik</h3><h2>Uygulamanızı güvenle planlayın.</h2><p>Hizmet kapsamını aracınıza göre netleştirip TSE ve ruhsat adımlarını anlaşılır bir plan halinde paylaşalım.</p></div></div></section>
    {related.length > 0 && <section class="services-section"><div class="shell"><div class="section-top"><div><h3 class="section-kicker">Aynı alandaki hizmetler</h3><h2 class="section-heading">İlgili teknik çözümler.</h2></div><a href="/arac-proje-hizmetlerimiz">Tüm hizmetler <ArrowRight size={16} /></a></div><div class="service-grid">{related.map((item) => <article class="service-card"><a class="service-card__image" href={`/${item.slug}`}><SiteImage src={item.image} alt={item.title} loading="lazy" /></a><div class="service-card__body"><p class="service-card__category">{item.category}</p><h3><a href={`/${item.slug}`}>{item.shortTitle}</a></h3><a class="text-link" href={`/${item.slug}`}>İncele <ArrowRight size={14} /></a></div></article>)}</div></div></section>}
  </main>
)}
