---
import Layout from '@/layouts/Layout.astro'
import InternalHero from '@/components/InternalHero.astro'
import ServiceCard from '@/components/ServiceCard.astro'
import { defaultServices, whatsappHref } from '@/data/site'
import { ArrowRight, BadgeCheck, Check, FileCheck, Wrench } from '@lucide/astro'

interface Props {
  title: string
  eyebrow?: string
  description: string
  heroImage?: string
  categories: string[]
  slug: string
}

const { title, eyebrow = 'Hizmetlerimiz', description, heroImage = '/karakas-muhendislik-arac-proje-hizmetleri-bg.webp', categories, slug } = Astro.props

const siteUrl = 'https://karakasmuhendislik.com.tr'
const pageUrl = `${siteUrl}${slug}`
const hubCategories = categories.map((category) => ({
  category,
  services: defaultServices.filter((service) => service.category === category).sort((a, b) => a.order - b.order),
}))
const totalServices = hubCategories.reduce((acc, c) => acc + c.services.length, 0)

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebPage',
      '@id': `${pageUrl}/#webpage`,
      'url': pageUrl,
      'name': `${title} | Karakaş Mühendislik`,
      'description': description,
      'breadcrumb': {
        '@type': 'BreadcrumbList',
        'itemListElement': [
          { '@type': 'ListItem', 'position': 1, 'name': 'Ana Sayfa', 'item': siteUrl },
          { '@type': 'ListItem', 'position': 2, 'name': title, 'item': pageUrl },
        ],
      },
    },
    {
      '@type': 'Service',
      '@id': `${pageUrl}/#service`,
      'name': title,
      'provider': {
        '@type': 'LocalBusiness',
        'name': 'Karakaş Mühendislik',
        'telephone': '0554 816 63 02',
        'address': {
          '@type': 'PostalAddress',
          'streetAddress': 'Altıparmak İş Merkezi Ofis No: 9',
          'addressLocality': 'Gaziosmanpaşa',
          'addressRegion': 'İstanbul',
          'addressCountry': 'TR',
        },
        'url': siteUrl,
      },
      'serviceType': title,
      'areaServed': 'TR',
    },
  ],
}
---

<Layout title={`${title} | Karakaş Mühendislik`} description={description}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <main>
    <InternalHero eyebrow={eyebrow} title={title} description={description} image={heroImage} />

    <section class="service-list-section">
      <div class="shell">
        {
          hubCategories.map((group) => (
            <div class="category-block">
              <div class="category-block__head">
                <h2>{group.category}</h2>
                <span>{group.services.length} hizmet</span>
              </div>
              <div class="service-grid">
                {group.services.map((service) => <ServiceCard service={service} />)}
              </div>
            </div>
          ))
        }
      </div>
    </section>

    <article class="border-t border-neutral-200 bg-white py-16 text-neutral-900 md:py-24">
      <div class="shell max-w-5xl">
        <div class="border-b border-neutral-200 pb-10">
          <h3 class="text-xs font-bold uppercase tracking-[0.16em] text-primary">Teknik Bilgilendirme ve Mevzuat</h3>
          <h2 class="mt-3 text-[clamp(2rem,4vw,3.2rem)] font-black leading-[1.05] tracking-[-0.05em] text-neutral-950">{title} Rehberi</h2>
          <p class="mt-5 text-base leading-relaxed text-neutral-700 sm:text-lg">
            Karakaş Mühendislik çatısı altında <strong>{title.toLowerCase()}</strong> kapsamında toplam {totalServices} farklı hizmet; araç başına teknik uygunluk, proje hazırlığı ve ruhsata işletme adımlarıyla yürütülür. Aşağıda yer alan her hizmet, kendi başvuru süreci ve belge gereksinimleriyle ayrıca açıklanmıştır.
          </p>
        </div>

        <section class="mt-14" aria-labelledby="tse-process-steps">
          <h3 id="tse-process-steps" class="text-2xl font-black tracking-tight text-neutral-950 sm:text-3xl">Süreç Nasıl İlerler?</h3>
          <p class="mt-4 text-base leading-relaxed text-neutral-700">İlgili hizmetin yasal hale gelmesi dört temel adımdan oluşan kontrollü bir akışla yürütülür:</p>
          <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
            <div class="border border-neutral-200 bg-[#f8f9fa] p-5">
              <span class="text-xs font-black uppercase tracking-wider text-primary">Adım 01</span>
              <h4 class="mt-2 text-base font-bold text-neutral-950">Teknik Ön Kontrol</h4>
              <p class="mt-2 text-xs leading-relaxed text-neutral-600">Araç ruhsatı, kimlik ve uygulanacak işleme ait belgeler mevzuata uygunluk açısından incelenir.</p>
            </div>
            <div class="border border-neutral-200 bg-[#f8f9fa] p-5">
              <span class="text-xs font-black uppercase tracking-wider text-primary">Adım 02</span>
              <h4 class="mt-2 text-base font-bold text-neutral-950">Proje Hazırlığı</h4>
              <p class="mt-2 text-xs leading-relaxed text-neutral-600">Gerekli teknik dosya, hesaplama ve başvuru belgeleri yetkili mühendislik tarafından hazırlanır.</p>
            </div>
            <div class="border border-neutral-200 bg-[#f8f9fa] p-5">
              <span class="text-xs font-black uppercase tracking-wider text-primary">Adım 03</span>
              <h4 class="mt-2 text-base font-bold text-neutral-950">Kontrol ve Onay</h4>
              <p class="mt-2 text-xs leading-relaxed text-neutral-600">TSE veya ilgili resmi merciide fiziki inceleme yapılır; uygunluk raporu düzenlenir.</p>
            </div>
            <div class="border border-neutral-200 bg-[#f8f9fa] p-5">
              <span class="text-xs font-black uppercase tracking-wider text-primary">Adım 04</span>
              <h4 class="mt-2 text-base font-bold text-neutral-950">Tescil ve Teslim</h4>
              <p class="mt-2 text-xs leading-relaxed text-neutral-600">Muayene ve noter işlemleri tamamlanarak güncel kayıt teslim alınır.</p>
            </div>
          </div>
        </section>

        <section class="mt-14 border-t border-neutral-200 pt-10" aria-labelledby="why-karakas">
          <h3 id="why-karakas" class="text-2xl font-black tracking-tight text-neutral-950 sm:text-3xl">Neden Karakaş Mühendislik?</h3>
          <p class="mt-4 text-base leading-relaxed text-neutral-700">
            İstanbul Gaziosmanpaşa merkezli ofisimizde, TSE tarafından yetkilendirilmiş uzman mühendislerimizle {title.toLowerCase()} süreçlerini mevzuata tam uyumlu olarak yönetiyoruz. Ön kontrolden tescil aşamasına kadar her adımda şeffaf ve hızlı destek sağlıyoruz.
          </p>
          <div class="mt-8 flex flex-wrap items-center gap-4">
            <a href={whatsappHref(`${title} hakkında bilgi almak istiyorum.`)} target="_blank" rel="noreferrer" class="inline-flex h-12 items-center gap-2.5 bg-[#25D366] hover:bg-[#1fb65a] px-6 text-xs font-black uppercase tracking-wider text-white shadow-sm transition-colors"><span>WhatsApp ile Danışın</span><ArrowRight size={15} /></a>
            <a href="/iletisim" class="inline-flex h-12 items-center gap-2 border border-neutral-900 bg-white hover:bg-neutral-950 hover:text-white px-6 text-xs font-black uppercase tracking-wider text-neutral-950 transition-colors"><span>İletişim ve Ofis Konumu</span><ArrowRight size={15} /></a>
          </div>
        </section>
      </div>
    </article>
  </main>
</Layout>
