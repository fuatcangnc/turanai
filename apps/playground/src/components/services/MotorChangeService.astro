              </blockquote>
            </div>
          ))}
        </div>
      </div>

      <!-- Physical Office & Google Maps -->
      <div class="mt-12 border-t border-neutral-200 pt-10">
        <h3 class="text-xs font-bold uppercase tracking-wider text-[#32667c]">Yüz yüze teknik değerlendirme</h3>
        <h3 class="mt-2 text-2xl font-black text-neutral-950">Motor değişim projenizi ofiste birlikte planlayalım</h3>
        <p class="mt-2 text-sm text-neutral-600">
          Ruhsatınızı ve yeni motorun bilgilerini getirin; gereken proje yolunu, evrakları ve sonraki başvuru adımlarını görüşmede netleştirelim.
        </p>

        <div class="mt-6 grid overflow-hidden border border-neutral-200 lg:grid-cols-[minmax(320px,.72fr)_minmax(0,1.28fr)]">
          <div class="bg-neutral-950 p-7 text-white sm:p-8 flex flex-col justify-between">
            <div>
              <MapPin class="size-8 text-sky-400" />
              <h4 class="mt-5 text-xs font-bold uppercase tracking-wider text-white/50">Fiziksel hizmet noktası</h4>
              <p class="mt-2 text-xl font-bold leading-snug">{siteSettings.location}</p>
              
              <dl class="mt-6 divide-y divide-white/10 border-y border-white/10 text-xs">
                <div class="py-3">
                  <dt class="text-white/50">Çalışma saatleri</dt>
                  <dd class="mt-0.5 font-bold">{siteSettings.workHours}</dd>
                </div>
                <div class="py-3">
                  <dt class="text-white/50">Telefon</dt>
                  <dd class="mt-0.5 font-bold">
                    <a href={phoneHref} class="hover:underline">{siteSettings.phone}</a>
                  </dd>
                </div>
              </dl>
            </div>

            <div class="mt-6 flex flex-col gap-2.5">
              <a
                href={defaultWhatsappHref}
                target="_blank"
                rel="noreferrer"
                class="inline-flex h-11 items-center justify-center gap-2 bg-[#25D366] hover:bg-[#1fb65a] px-5 text-xs font-bold text-white transition-colors"
              >
                <span>Ofis görüşmesi için yazın</span>
                <ArrowRight size={14} />
              </a>
              <a
                href="https://www.google.com/maps/search/?api=1&query=Karaka%C5%9F%20M%C3%BChendislik%20Gaziosmanpa%C5%9Fa%20%C4%B0stanbul"
                target="_blank"
                rel="noreferrer"
                class="inline-flex h-11 items-center justify-center gap-2 border border-white/30 hover:bg-white hover:text-neutral-950 px-5 text-xs font-bold text-white transition-colors"
              >
                <span>Yol tarifi alın</span>
                <ArrowRight size={14} />
              </a>
            </div>
          </div>

          <div class="relative min-h-[360px] bg-neutral-100">
            <iframe
              src={googleMapsEmbedURL}
              class="absolute inset-0 size-full border-0"
              loading="lazy"
              referrerpolicy="strict-origin-when-cross-origin"
              title="Karakaş Mühendislik Gaziosmanpaşa ofis konumu"
              allowfullscreen
            ></iframe>
          </div>
        </div>
      </div>
    </section>

    <!-- 10 · Sık Sorulanlar (Accordion FAQs) -->
    <section class="mt-16" aria-labelledby="motor-faq-title">
      <h3 class="text-[13px] font-bold uppercase tracking-[0.14em] text-neutral-900">10 · Sık sorulanlar</h3>
      <h2 class="mt-3 text-[clamp(1.8rem,3.5vw,2.65rem)] font-black leading-tight tracking-tight text-neutral-950" id="motor-faq-title">
        Motor Değişim Projesi Hakkında Sık Sorulan Sorular
      </h2>

      <div class="mt-8 space-y-3">
        {service.faqs?.map((faq, index) => (
          <details class="group border border-neutral-200 bg-[#f7f8f8] open:border-l-4 open:border-l-primary open:bg-white transition-colors" open={index === 0}>
            <summary class="flex min-h-14 cursor-pointer list-none items-center justify-between gap-4 px-6 text-sm sm:text-base font-bold text-neutral-950 select-none">
              <span>{faq.question}</span>
              <ChevronDown class="size-4 shrink-0 text-neutral-500 group-open:rotate-180 transition-transform" />
            </summary>
            <div class="px-6 pb-5 pt-2 text-xs sm:text-sm text-neutral-600 leading-relaxed border-t border-neutral-100">
              <p>{faq.answer}</p>
            </div>
          </details>
        ))}
      </div>
    </section>

    <!-- Bottom CTA Banner -->
    <section class="mt-16 border-t-[3px] border-primary pt-8">
      <h3 class="text-xs font-black uppercase tracking-wider text-neutral-900">Ücretsiz ön değerlendirme</h3>
      <h2 class="mt-2 text-2xl sm:text-3xl font-black text-neutral-950">Motor değişikliği projeniz için bilgileri iletin.</h2>
      <p class="mt-2 text-sm text-neutral-600 max-w-2xl">
        Araç ve motor bilgilerini inceleyip hangi proje yolunun uygun olduğunu belirleyelim.
      </p>
      <a
        href={defaultWhatsappHref}
        target="_blank"
        rel="noreferrer"
        class="mt-6 inline-flex h-12 items-center gap-2 bg-[#25D366] hover:bg-[#1fb65a] px-6 text-xs font-black uppercase tracking-wider text-white transition-colors shadow-sm"
      >
        <span>WhatsApp'tan bilgi alın</span>
        <ArrowRight size={14} />
      </a>
      <p class="mt-6 flex items-start gap-2 text-xs text-neutral-500">
        <Check class="mt-0.5 size-4 shrink-0 text-neutral-900" />
        <span>Teknik kapsam, araç ile motor bilgileri ve yapılan uygulama incelendikten sonra kesinleşir.</span>
      </p>
    </section>

  </div>
</article>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const quickForm = document.getElementById('service-quick-form')
    if (quickForm) {
      quickForm.addEventListener('submit', (e) => {
        e.preventDefault()
        const fullName = document.getElementById('quick-fullName')?.value || ''
        const phone = document.getElementById('quick-phone')?.value || ''
        const serviceTitle = document.querySelector('h1')?.innerText?.trim() || 'Araç Motor Değişimi Projesi'
        
        const lines = [
          'Merhaba,',
          `*${serviceTitle}* için teklif ve bilgi almak istiyorum.`,
          '',
          `*Ad Soyad:* ${fullName}`,
          `*Telefon:* ${phone}`
        ]
        
        const whatsappNumber = '905548166302'
        window.open(`https://wa.me/${whatsappNumber}?text=${encodeURIComponent(lines.join('\n'))}`, '_blank')
      })
    }
  })
</script>
