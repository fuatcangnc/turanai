---
import { ArrowRight, BadgeCheck, Check, ChevronDown, FileCheck, MapPin, Star } from '@lucide/astro'
import { phoneHref, siteSettings, whatsappHref } from '@/data/site'
import serviceData from '@/content/services/arac-motor-degisim-projesi.json'
import SiteImage from '../SiteImage.astro'

interface Props {
  service?: typeof serviceData
}

const { service = serviceData } = Astro.props

const defaultWhatsappHref = whatsappHref('Merhaba, aracım için motor değişikliği projesi hakkında bilgi almak istiyorum.')

const googleReviews = [
  {
    initials: 'Z',
    name: 'Zübeyde ZENGİN',
    publishedAt: 'bir yıl önce',
    quote: 'Konusunda uzman bir firma, herkese tavsiye ederim.',
    avatarBg: 'bg-[#1769aa]',
  },
  {
    initials: 'İ',
    name: 'İsmail Can Ayvat',
    publishedAt: '4 yıl önce',
    quote: 'Çok memnun kaldım, uygun fiyata kaliteli hizmet sağlayan bir firma kendileri.',
    avatarBg: 'bg-[#b63a32]',
  },
  {
    initials: 'A',
    name: 'Avrupa Basım Hizmetleri',
    publishedAt: 'bir yıl önce',
    quote: 'Konusunda deneyimli, çözüm odaklı kaliteli hizmet.',
    avatarBg: 'bg-[#d8752f]',
  },
  {
    initials: 'C',
    name: 'Cem Abatay',
    publishedAt: 'bir yıl önce',
    quote: 'Çok yardımcı oldu, herkesin gelmesini tavsiye ederim.',
    avatarBg: 'bg-[#7e57c2]',
  },
]

const credentials = [
  {
    label: 'Kalite yönetimi',
    title: 'ISO 9001 Kalite Yönetim Sistemi',
    description: 'Hizmet süreçlerini sürekli iyileştirmeyi ve müşteri memnuniyetini yükseltmeyi amaçlayan kalite yönetim sistemidir.',
    image: '/belgeler/iso-9001.webp',
    alt: 'ISO 9001 Kalite Yönetim Sistemi logosu',
  },
  {
    label: 'Çevre yönetimi',
    title: 'ISO 14001 Çevre Yönetim Sistemi',
    description: 'Çevresel etkileri azaltmayı ve kaynakları sorumlu kullanmayı esas alan çevre yönetim sistemidir.',
    image: '/belgeler/iso-14001.webp',
    alt: 'ISO 14001 Çevre Yönetim Sistemi logosu',
  },
  {
    label: 'İş sağlığı ve güvenliği',
    title: 'ISO 45001 İş Sağlığı ve Güvenliği Yönetim Sistemi',
    description: 'Çalışan güvenliğini önceleyen, riskleri sistemli biçimde yönetmeye dayalı iş sağlığı ve güvenliği sistemidir.',
    image: '/belgeler/iso-45001.webp',
    alt: 'ISO 45001 İş Sağlığı ve Güvenliği Yönetim Sistemi logosu',
  },
  {
    label: 'Araç proje yetkisi',
    title: 'TSE AİTM Yetki Belgesi',
    description: 'Araç tadilat projelerinde teknik proje yetkisini belgeleyen TSE AİTM yetki belgesidir.',
    image: '/belgeler/tse.webp',
    alt: 'Türk Standardları Enstitüsü logosu',
    isTse: true,
  },
]

const googleMapsEmbedURL =
  'https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3008.5541654988383!2d28.914657499999997!3d41.056877799999995!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x14cab713cf4631bf%3A0xd4b7db3809bdcddd!2zS0FSQUtBxZ4gTcOcSEVORMSwU0zEsEsgVFNFIE9OQVlMSSBBUkHDhyBQUk9KRSBGxLBSTUEgQkVMR0VMRU5ExLBSTUUgTcOcxZ5BVsSwUkzEsEsgdmUgT1RPTU9UxLBWIEjEsFpNRVRMRVLEsCBSRVNVTCBLQVJBS0HFng!5e0!3m2!1sen!2str!4v1786376364824!5m2!1sen!2str'
---

<!-- Schema.org JSON-LD (BreadcrumbList + Service + FAQPage) -->
<script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Ana Sayfa",
          "item": "https://karakasmuhendislik.com.tr"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Araç Proje Hizmetlerimiz",
          "item": "https://karakasmuhendislik.com.tr/arac-proje-hizmetlerimiz"
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": service.shortTitle || service.title,
          "item": `https://karakasmuhendislik.com.tr/${service.slug}`
        }
      ]
    },
    {
      "@type": "Service",
      "name": service.title,
      "description": service.summary || service.heroDescription,
      "provider": {
        "@type": "LocalBusiness",
        "name": "Karakaş Mühendislik",
        "telephone": siteSettings.phone,
        "address": {
          "@type": "PostalAddress",
          "addressLocality": "Gaziosmanpaşa",
          "addressRegion": "İstanbul",
          "addressCountry": "TR"
        }
      },
      "url": `https://karakasmuhendislik.com.tr/${service.slug}`
    },
    ...(service.faqs && service.faqs.length > 0 ? [{
      "@type": "FAQPage",
      "mainEntity": service.faqs.map((faq) => ({
        "@type": "Question",
        "name": faq.question,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": faq.answer
        }
      }))
    }] : [])
  ]
})} />

<!-- Hero Section -->
<section class="relative isolate min-h-[32rem] overflow-hidden bg-[#f4f4f4]">
  <div class="absolute inset-0 z-0 overflow-hidden">
    <SiteImage
      src="/karakas-muhendislik-arac-proje-hizmetleri-bg.webp"
      alt={service.heroTitle || service.title}
      class="size-full object-cover object-center"
      loading="eager"
      fetchpriority="high"
    />
  </div>
  <div class="absolute inset-0 z-10 bg-[linear-gradient(to_bottom,rgba(255,255,255,0.92)_0%,rgba(255,255,255,0.85)_100%)] lg:bg-[linear-gradient(90deg,#ffffff_0%,rgba(255,255,255,0.96)_35%,rgba(255,255,255,0.82)_60%,rgba(255,255,255,0.45)_85%,rgba(255,255,255,0.25)_100%)]" aria-hidden="true"></div>
  
  <div class="shell relative z-20 grid min-h-[32rem] items-center gap-10 py-12 lg:grid-cols-[minmax(0,1fr)_25rem] lg:gap-12 xl:grid-cols-[minmax(0,1fr)_27rem]">
    <div class="max-w-3xl">
      <!-- Breadcrumb -->
      <nav class="mb-3 flex items-center gap-2 text-xs font-semibold text-neutral-500" aria-label="Breadcrumb" itemscope itemtype="https://schema.org/BreadcrumbList">
        <span itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
          <a itemprop="item" href="/" class="hover:text-primary transition-colors">
            <span itemprop="name">Ana Sayfa</span>
          </a>
          <meta itemprop="position" content="1" />
        </span>
        <span aria-hidden="true">/</span>
        <span itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
          <a itemprop="item" href="/arac-proje-hizmetlerimiz" class="hover:text-primary transition-colors">
            <span itemprop="name">Araç Proje Hizmetlerimiz</span>
          </a>
          <meta itemprop="position" content="2" />
        </span>
        <span aria-hidden="true">/</span>
        <span itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
          <span itemprop="name" class="text-neutral-900">{service.shortTitle}</span>
          <meta itemprop="item" content={`https://karakasmuhendislik.com.tr/${service.slug}`} />
          <meta itemprop="position" content="3" />
        </span>
      </nav>

      <h2 class="text-[13px] font-bold uppercase tracking-[0.14em] text-primary">
        {service.heroEyebrow || 'Araç Motor Değişimi | TSE Onaylı'}
      </h2>
      
      <h1 class="mt-3 text-[clamp(2.2rem,3.8vw,3.6rem)] font-black leading-[1.03] tracking-[-0.05em] text-neutral-950">
        {service.heroTitle || service.title}
      </h1>
      
      <p class="mt-4 max-w-2xl text-base leading-relaxed text-neutral-700">
        {service.heroDescription || service.summary}
      </p>
      
      <div class="mt-6 flex flex-wrap items-center gap-3">
        <a
          href={defaultWhatsappHref}
          target="_blank"
          rel="noreferrer"
          class="inline-flex h-11 items-center gap-2.5 bg-[#25D366] hover:bg-[#1fb65a] px-5 text-xs font-black uppercase tracking-wider text-white shadow-sm transition-colors"
        >
          <span>WhatsApp'tan bilgi alın</span>
          <ArrowRight size={15} />
        </a>
        
        <a
          href={defaultWhatsappHref}
          target="_blank"
          rel="noreferrer"
          class="inline-flex h-11 items-center gap-2 border border-neutral-900 bg-white/90 hover:bg-neutral-950 hover:text-white px-5 text-xs font-black uppercase tracking-wider text-neutral-950 transition-colors"
        >
          <span>Ücretsiz ön değerlendirme</span>
          <ArrowRight size={15} />
        </a>
      </div>
    </div>

    <!-- Quick Offer Form on the Right -->
    <form
      id="service-quick-form"
      class="relative z-10 w-full max-w-[27rem] justify-self-end border-t-[3px] border-primary bg-white p-5 text-[#1a1a1a] shadow-[0_20px_50px_rgba(4,24,39,0.14)] sm:p-6"
    >
      <div class="flex items-start justify-between gap-3 border-b border-neutral-200 pb-3">
        <div>
          <h3 class="text-[11px] font-black uppercase tracking-[0.16em] text-primary">
            Hızlı Teklif Formu
          </h3>
          <h2 class="mt-1 text-[17px] font-black tracking-tight text-neutral-950 sm:text-[19px]">
            {service.shortTitle} Teklifi Al
          </h2>
        </div>
        <span class="grid size-9 shrink-0 place-items-center rounded-full bg-[#25D366]/15 text-[#1cae56]">
          <svg class="size-4 fill-current" viewBox="0 0 24 24">
            <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.711 2.598 2.664-.699c.971.53 1.839.814 2.796.814 3.18 0 5.766-2.587 5.767-5.766.001-3.18-2.585-5.766-5.767-5.766zm3.374 8.211c-.141.398-.716.732-1.002.779-.271.045-.589.07-.954-.047-.367-.117-.843-.275-1.447-.538-2.544-1.109-4.183-3.696-4.31-3.865-.126-.17-1.026-1.365-1.026-2.604 0-1.239.65-1.849.881-2.1.231-.252.504-.315.672-.315.168 0 .336.002.483.01.155.008.363-.059.567.432.21.505.714 1.744.777 1.871.063.126.105.274.021.442-.084.168-.126.273-.252.421-.126.147-.265.328-.378.441-.126.126-.258.263-.111.515.147.252.654 1.08 1.401 1.746.962.857 1.774 1.123 2.026 1.249.252.126.399.105.546-.063.147-.168.63-.736.798-.988.168-.252.336-.21.567-.126.231.084 1.47.693 1.722.819.252.126.42.189.483.294.063.105.063.609-.078 1.007z"/>
          </svg>
        </span>
      </div>

      <p class="mt-2.5 text-xs leading-5 text-neutral-600">
        Adınızı ve telefonunuzu yazın; teklif talebiniz hazır mesaj olarak WhatsApp'a yönlendirilsin.
      </p>

      <div class="mt-3.5 space-y-2.5">
        <div>
          <label for="quick-fullName" class="block text-[11px] font-bold uppercase tracking-wider text-neutral-700">Ad Soyad</label>
          <input
            id="quick-fullName"
            type="text"
            name="fullName"
            required
            autocomplete="name"
            placeholder="Adınız ve Soyadınız"
            class="mt-1 h-9 w-full rounded-none border border-neutral-300 bg-[#f9f9f9] px-3 text-xs text-neutral-900 outline-none transition focus:border-primary focus:bg-white"
          />
        </div>
        <div>
          <label for="quick-phone" class="block text-[11px] font-bold uppercase tracking-wider text-neutral-700">Telefon Numarası</label>
          <input
            id="quick-phone"
            type="tel"
            name="phone"
            required
            autocomplete="tel"
            placeholder="05xx xxx xx xx"
            class="mt-1 h-9 w-full rounded-none border border-neutral-300 bg-[#f9f9f9] px-3 text-xs text-neutral-900 outline-none transition focus:border-primary focus:bg-white"
          />
        </div>
      </div>

      <button
        type="submit"
        class="mt-4 inline-flex h-12 w-full items-center justify-center gap-2 border-0 bg-[#25D366] hover:bg-[#1fb65a] px-4 text-[16px] font-bold text-white transition-colors cursor-pointer"
      >
        <span>WhatsApp ile iletişime geç</span>
        <ArrowRight size={18} />
      </button>

      <div class="mt-3 flex items-center justify-between border-t border-neutral-100 pt-2.5 text-[11px] text-neutral-500">
        <span class="inline-flex items-center gap-1 font-semibold text-emerald-700">
          <Check size={13} /> TSE Yetkili Mühendislik
        </span>
        <span>Hızlı Yanıt</span>
      </div>
    </form>
  </div>

  <!-- Custom geometric white dividers (Left & Right) -->
  <div class="custom-divider-white-left absolute -bottom-[1px] left-0 z-20 pointer-events-none border-0 outline-none shadow-none" aria-hidden="true"></div>
  <div class="custom-divider-white-right absolute -bottom-[1px] right-0 z-20 pointer-events-none border-0 outline-none shadow-none" aria-hidden="true"></div>
</section>

<!-- Main Article Body -->
<article class="bg-white py-14 md:py-20 text-neutral-900">
  <div class="shell max-w-6xl">
    
    <!-- Article Header -->
    <div class="border-b border-neutral-200 pb-10">
      <h3 class="text-base font-bold uppercase tracking-[0.14em] text-primary">
        {service.articleEyebrow || 'Motor Değişim Projesi'}
      </h3>
      <h2 class="mt-4 text-[clamp(2rem,4vw,3.2rem)] font-black leading-[1.03] tracking-[-0.05em] text-neutral-950">
        {service.articleTitle || service.title}
      </h2>
      <p class="mt-6 text-base sm:text-lg leading-relaxed text-neutral-700">
        {service.articleLead1}
      </p>
      <p class="mt-4 text-base sm:text-lg leading-relaxed text-neutral-700">
        {service.articleLead2}
      </p>
      <div class="mt-7 flex flex-wrap items-center gap-x-8 gap-y-2 border-t border-neutral-200 pt-5 text-sm text-neutral-500">
        <p>Hazırlayan: <strong class="font-bold text-neutral-900">{service.articleAuthor || 'Karakaş Mühendislik'}</strong></p>
        <p>Son güncelleme: <time datetime="2026-08-10">{service.articleUpdated || '10 Ağustos 2026'}</time></p>
      </div>
    </div>

    <!-- 3 Summary Badges -->
    <section class="mt-10 grid border-y border-neutral-200 sm:grid-cols-3">
      {service.summaryCards?.map((item) => (
        <div class={`border-b border-neutral-200 px-6 py-6 last:border-b-0 sm:border-b-0 sm:border-r sm:last:border-r-0 ${item.className}`}>
          <p class="text-[22px] font-black tracking-tight">{item.value}</p>
          <p class={`mt-2 text-sm leading-normal ${item.labelClassName}`}>{item.label}</p>
        </div>
      ))}
    </section>

    <!-- Article Featured Image -->
    {service.articleImage && (
      <figure class="mt-10 overflow-hidden border border-neutral-200 bg-[#f7f8f8]">
        <SiteImage
          src={service.articleImage}
          alt={service.title}
          class="h-auto w-full object-cover"
          loading="lazy"
          width="1672"
          height="941"
        />
      </figure>
    )}

    <!-- 01 · Uygun Proje Yolu -->
    <section class="mt-16" aria-labelledby="motor-path-title">
      <h3 class="text-[13px] font-bold uppercase tracking-[0.14em] text-primary">
        01 · Uygun proje yolu
      </h3>
      <h2 class="mt-3 text-[clamp(1.8rem,3.5vw,2.65rem)] font-black leading-tight tracking-tight text-neutral-950" id="motor-path-title">
        Montaj uygunluk ile motor tadilat projesi arasındaki fark nedir?
      </h2>
      <p class="mt-5 text-base sm:text-lg leading-relaxed text-neutral-700">
        Sıfır motor her zaman montaj uygunluk, çıkma motor da her zaman tadilat anlamına gelmez. Dosya türünü motorun yaşı değil, eski motorla arasındaki teknik fark belirler. Güç, hacim, yakıt, model yılı ve emisyon bilgileri karşılaştırılınca izlenecek yol ortaya çıkar.
      </p>

      <!-- Decision Flowchart Box -->
      <div class="mt-8" aria-label="Motor değişimi dosya türü karar grafiği">
        <div class="mx-auto max-w-xl border border-neutral-800 bg-[#17222c] px-6 py-5 text-center text-white">
          <h4 class="text-xs font-bold uppercase tracking-[0.12em] text-white/60">Başlangıç sorusu</h4>
          <p class="mt-2 text-lg sm:text-xl font-bold">{service.decisionTree?.startQuestion}</p>
        </div>
        <div class="mx-auto hidden h-10 w-px bg-neutral-300 md:block"></div>
        <div class="grid gap-6 md:grid-cols-2 md:gap-8">
          <!-- Option A -->
          <section class="border border-[#b8d5df] bg-[#f1f7f9] p-6 md:p-7">
            <h4 class="text-xs font-bold uppercase tracking-[0.12em] text-[#32667c]">{service.decisionTree?.optionA.label}</h4>
            <h3 class="mt-2 text-xl font-black text-neutral-950">{service.decisionTree?.optionA.title}</h3>
            <p class="mt-3 text-sm leading-relaxed text-neutral-600">{service.decisionTree?.optionA.description}</p>
            <ul class="mt-5 space-y-2.5 border-t border-neutral-200 pt-5">
              {service.decisionTree?.optionA.items.map((item) => (
                <li class="flex items-start gap-2.5 text-sm font-medium text-neutral-800">
                  <Check class="mt-0.5 size-4 shrink-0 text-emerald-700" />
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </section>

          <!-- Option B -->
          <section class="border border-[#f1c79e] bg-[#fff4e8] p-6 md:p-7">
            <h4 class="text-xs font-bold uppercase tracking-[0.12em] text-[#b94e17]">{service.decisionTree?.optionB.label}</h4>
            <h3 class="mt-2 text-xl font-black text-neutral-950">{service.decisionTree?.optionB.title}</h3>
            <p class="mt-3 text-sm leading-relaxed text-neutral-600">{service.decisionTree?.optionB.description}</p>
            <ul class="mt-5 space-y-2.5 border-t border-neutral-200 pt-5">
              {service.decisionTree?.optionB.items.map((item) => (
                <li class="flex items-start gap-2.5 text-sm font-medium text-neutral-800">
                  <Check class="mt-0.5 size-4 shrink-0 text-amber-700" />
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </section>
        </div>
      </div>

      <!-- Pre-purchase Warning Callout -->
      <aside class="mt-10 border-y border-neutral-200 py-7 sm:flex sm:items-center sm:justify-between sm:gap-8">
        <div class="max-w-3xl">
          <h3 class="text-lg sm:text-xl font-black text-neutral-950">Motoru satın almadan önce ön kontrol yaptırın.</h3>
          <p class="mt-1.5 text-sm leading-relaxed text-neutral-600">
            Ruhsatı, motor numarasını ve bildiğiniz teknik verileri gönderin. Hangi dosyanın gerektiğine motoru taktırmadan önce bakalım.
          </p>
        </div>
        <a
          href={defaultWhatsappHref}
          target="_blank"
          rel="noreferrer"
          class="mt-5 inline-flex h-11 shrink-0 items-center justify-center gap-2 bg-[#25D366] hover:bg-[#1fb65a] px-5 text-xs font-black uppercase tracking-wider text-white transition-colors sm:mt-0"
        >
          <span>WhatsApp'tan gönderin</span>
          <ArrowRight size={14} />
        </a>
      </aside>
    </section>

    <!-- 02 · İşlem Akışı (6-Step Timeline) -->
    <section class="mt-16 border border-neutral-200 bg-[#f7f8f8] p-6 sm:p-8 lg:p-10" aria-labelledby="motor-process-title">
      <div class="border-b border-neutral-200 pb-6">
        <h3 class="text-[13px] font-bold uppercase tracking-[0.14em] text-[#32667c]">02 · İşlem akışı</h3>
        <h2 class="mt-2 text-[clamp(1.8rem,3.5vw,2.65rem)] font-black leading-tight tracking-tight text-neutral-950" id="motor-process-title">
          Motor Değişim Projesi Süreci
        </h2>
        <p class="mt-4 text-base leading-relaxed text-neutral-700">
          Motor değişim projesi nasıl yapılır? Süreç altı ana adımda tamamlanır. Teknik uygunluk kontrolünden sonra evraklar ve proje dosyası hazırlanır. Araç TSE kontrolü ile TÜVTÜRK tadilat muayenesinden geçince yeni motor bilgisi noterde ruhsata işlenir.
        </p>
      </div>

      <div class="mt-8 relative">
        <ol class="grid gap-6 lg:grid-cols-6 lg:gap-0">
          {service.processSteps?.map((step, index) => {
            const isLast = index === service.processSteps.length - 1
            const badgeBg = isLast ? 'bg-emerald-600 text-white' : index === 2 ? 'bg-primary text-white' : 'bg-[#17222c] text-white'
            return (
              <li class="relative flex flex-col border-b border-neutral-200 pb-6 pl-16 last:border-b-0 last:pb-0 lg:border-b-0 lg:border-r lg:px-4 lg:last:border-r-0">
                <span class={`absolute left-0 top-0 grid size-11 place-items-center text-sm font-black ring-4 ring-white lg:relative lg:mx-auto ${badgeBg}`}>
                  {step.number}
                </span>
                <p class="text-[11px] font-bold uppercase tracking-wider text-neutral-400 lg:mt-6">
                  Adım {index + 1}/{service.processSteps.length}
                </p>
                <h3 class="mt-2 text-base font-black leading-tight text-neutral-950">
                  {step.title}
                </h3>
                <p class="mt-2 text-xs sm:text-sm leading-relaxed text-neutral-600">
                  {step.description}
                </p>
                {isLast && (
                  <p class="mt-4 flex items-center gap-1.5 text-xs font-bold text-emerald-700 lg:mt-auto lg:pt-4">
                    <Check class="size-4 shrink-0" /> Tescil tamamlanır
                  </p>
                )}
              </li>
            )
          })}
        </ol>
      </div>
    </section>

    <!-- 03 · Teknik Uygunluk -->
    <section class="mt-16" aria-labelledby="motor-technical-title">
      <h3 class="text-[13px] font-bold uppercase tracking-[0.14em] text-primary">03 · Teknik uygunluk</h3>
