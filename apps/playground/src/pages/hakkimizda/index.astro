---
import { Compass, FileCheck, Scale, ShieldCheck } from '@lucide/astro'
import Layout from '@/layouts/Layout.astro'
import InternalHero from '@/components/InternalHero.astro'
import SiteImage from '@/components/SiteImage.astro'
import { siteSettings } from '@/data/site'
---

<Layout title="Hakkımızda | Karakaş Mühendislik" description="Karakaş Mühendislik araç proje ve TSE onay süreçlerindeki çalışma yaklaşımı."><main><InternalHero eyebrow="Kurumsal" title="Mühendislik kararlarını güvenli tescil süreçlerine dönüştürüyoruz." description="Karakaş Mühendislik; araç üzerindeki değişiklikleri teknik doğruluk, mevzuat uyumu ve açık iletişimle projelendirir. Amacımız yalnızca dosya hazırlamak değil, süreci öngörülebilir kılmaktır." /><section class="prose-section"><div class="shell" style="display:grid; gap:3rem; align-items:center"><div style="max-width:42rem"><h3 class="section-kicker">Çalışma yaklaşımımız</h3><h2 class="section-heading">Teknik ayrıntıyı anlaşılır bir yol haritasına çeviririz.</h2><p class="section-lead">Araç tadilatı ve dönüşüm süreçlerinde küçük bir teknik ayrıntı dahi onay ve tescil adımlarını etkileyebilir. Bu nedenle her talebi araç, uygulama ve kullanım amacı özelinde değerlendiririz.</p><p class="section-lead">Müşterilerimizin hangi belgeye, hangi sırayla ve neden ihtiyaç duyduğunu bilmesini önemseriz. Sürecin her aşamasında açık, ölçülebilir ve mevzuata dayalı bilgi sunarız.</p><a class="button button--primary" href="/iletisim" style="margin-top:1.5rem">Projenizi değerlendirelim</a></div><SiteImage src="/images/project-guidance.webp" alt="Araç projesini değerlendiren mühendislik ekibi" style="width:100%; max-height:30rem; object-fit:cover" /></div></section><section class="process-section"><div class="shell"><h3 class="section-kicker">İlkelerimiz</h3><h2 class="section-heading">Her projede aynı dört temel ilke.</h2><div class="service-grid" style="margin-top:2rem">{[[Scale,'Mevzuata uygunluk','Teknik kararları güncel gerekliliklerle uyumlu ele alırız.'],[FileCheck,'Eksiksiz dosya','Başvuru ve kontrol adımları için gerekli teknik bilgileri düzenleriz.'],[Compass,'Açık yol haritası','Süreçteki adımları, sorumlulukları ve olası riskleri baştan açıklarız.'],[ShieldCheck,'Güvenlik odağı','Uygulamanın yalnızca tescilini değil, güvenli kullanımını da gözetiriz.']].map(([Icon,title,text]) => <article class="service-card" style="padding:1.5rem"><Icon size={28} color="var(--primary)" /><h3 style="margin-top:1.5rem">{title}</h3><p style="color:var(--muted);line-height:1.7;font-size:.8rem">{text}</p></article>)}</div></div></section><section class="dark-band"><div class="shell dark-band__grid"><div><h3 class="eyebrow">{siteSettings.brandName}</h3><h2>Aracınız için doğru teknik kararı birlikte verelim.</h2></div><a class="dark-band__link" href="/iletisim">İletişime geçin <span>→</span></a></div></section></main></Layout>
