---
import { ArrowRight, Bike, Check, MessageCircle, ShieldCheck, Wrench } from '@lucide/astro'
import Layout from '@/layouts/Layout.astro'
import InternalHero from '@/components/InternalHero.astro'
import { whatsappHref } from '@/data/site'

const motorcycleBrands = [
  {
    name: 'Honda',
    type: 'Scooter & Touring',
    popularModels: ['PCX 125', 'Forza 250', 'Dio', 'Activa', 'NC750X'],
    description: 'PCX, Forza, Dio ve Activa kurye çantası ile touring modellerinde çanta ve şase tadilat projesi.',
  },
  {
    name: 'Yamaha',
    type: 'Maxi Scooter & Sport',
    popularModels: ['NMAX 125/155', 'XMAX 250', 'Tracer 7/9', 'MT-07'],
    description: 'NMAX, XMAX paket servis kutusu ve Tracer serisi yan/arka çanta tescil projeleri.',
  },
  {
    name: 'BMW Motorrad',
    type: 'Adventure & Maxi Scooter',
    popularModels: ['R 1250 GS', 'F 850 GS', 'C 400 GT', 'R 1300 GS'],
    description: 'GS serisi üçlü alüminyum çanta seti ve C 400 serisi arka taşıma kutusu ruhsat kaydı.',
  },
  {
    name: 'Vespa',
    type: 'İtalyan Klasik Scooter',
    popularModels: ['Primavera 150', 'GTS 300', 'Sprint 125'],
    description: 'Özgün arka çanta ve demir montajlarında TSE standartlarına uygun mühendislik projesi.',
  },
  {
    name: 'Piaggio',
    type: 'Şehir & Teslimat Scooter',
    popularModels: ['Medley 150', 'Beverly 400', 'Liberty 125'],
    description: 'Medley ve Liberty kurye taşıma kutusu ile şase tadilatı tescil işlemleri.',
  },
  {
    name: 'Kymco',
    type: 'Scooter & Maxi Scooter',
    popularModels: ['Agility Carry', 'DTX 360', 'Xciting 400', 'People S'],
    description: 'Agility Carry teslimat kasası ve DTX serisi arka çanta projelendirmesi.',
  },
  {
    name: 'Sym',
    type: 'Ticari & Şehir Scooter',
    popularModels: ['Jet 14', 'Fiddle', 'Symphony', 'ADX 125', 'Joymax'],
    description: 'Jet 14 ve Symphony kurye çantası ruhsata işletme ve teknik onay süreci.',
  },
  {
    name: 'CFMoto',
    type: 'Touring & Adventure',
    popularModels: ['250 SR', '450 SR', '700 CL-X', '800 MT'],
    description: '800 MT touring çanta setleri ve 250/450 serisi şase değişim projeleri.',
  },
  {
    name: 'Bajaj',
    type: 'Commuter & Naked',
    popularModels: ['Pulsar NS200', 'Dominar 400', 'Pulsar RS200'],
    description: 'Pulsar ve Dominar modellerinde paket servis kutusu ve arka çanta işletme.',
  },
  {
    name: 'RKS',
    type: 'Şehir & Teslimat Scooter',
    popularModels: ['Bitter 125', 'Wildcat', 'Freccia 150', 'Spontini'],
    description: 'RKS teslimat modellerinde hazır çanta demiri ve kutu tescil projesi.',
  },
  {
    name: 'Mondial',
    type: 'Scooter & Touring',
    popularModels: ['Drift L', 'Turismo', 'Revival', 'Wing 50'],
    description: 'Drift L ve Turismo motosikletlerinde kurye çantası ve şase değişim dosyası.',
  },
  {
    name: 'Arora',
    type: 'Scooter & Elektrikli',
    popularModels: ['Cappucino 125', 'Safari', 'Beat 125', 'Mojito'],
