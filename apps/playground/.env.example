# Turan test anahtarları — kopyalayıp .env yapın (gitignore'da).
# Not: Node dev sunucusu .env'i process.env'e AKTARMAZ; şu şekilde başlatın:
#   set -a; . ./.env; set +a; pnpm --filter playground dev
# veya değerleri admin → Plugins → Turan AI ayarlarına girin (şifreli saklanır).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Evren — OpenAI-uyumlu ağ geçidi (modele "Evren · DeepSeek V4.1 Flash" olarak ekli)
EVREN_API_KEY=
EVREN_BASE_URL=https://evren-llmapi.ssyz.org.tr/v1
